# Backend Environment Variables
PORT=5000
MONGO_URI=mongodb://localhost:27017/vetnest
JWT_SECRET=vetnest_super_secret_jwt_key_bengaluru_2026

# Allowed Frontend Origins (Production & Development CORS)
CLIENT_OWNER_URL=http://localhost:3000
CLIENT_STAFF_URL=http://localhost:3001

# Live Simulation Settings
SIMULATION_INTERVAL_MS=20000

# Email notifications (Brevo HTTPS API - works on free Render, unlike Gmail SMTP)
# 1) Create a free account at brevo.com  2) Settings > API Keys > generate a key
# 3) Settings > Senders > add + VERIFY the address below (click the link Brevo emails you)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM_ADDRESS=your-verified-sender@gmail.com
EMAIL_FROM_NAME=VetNest
